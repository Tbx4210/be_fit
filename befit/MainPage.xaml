<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="befit.MainPage"
             xmlns:model="clr-namespace:befit.Models"
             Title="Dashboard"
             BackgroundColor="#F5F5F5">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- User Profile Card -->
            <Frame CornerRadius="15" Padding="20" BackgroundColor="#512BD4">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{Binding CurrentUser.Name}" 
                           FontSize="22" 
                           TextColor="White"
                           FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="*,*" RowSpacing="5">
                        <Label Text="{Binding CurrentUser.Age, StringFormat='Age: {0}'}"
                               TextColor="White" Grid.Column="0" Grid.Row="0"/>
                        <Label Text="{Binding CurrentUser.Height, StringFormat='Height: {0} cm'}"
                               TextColor="White" Grid.Column="1" Grid.Row="0"/>
                        <Label Text="{Binding CurrentUser.Weight, StringFormat='Weight: {0} kg'}"
                               TextColor="White" Grid.Column="0" Grid.Row="1"/>
                        <Label Text="{Binding CurrentUser.FitnessGoal}"
                               TextColor="White" Grid.Column="1" Grid.Row="1"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- Today's Workouts Section -->
            <Frame CornerRadius="15" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="Today's Workouts" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           Margin="15,15,15,10"/>

                    <BoxView HeightRequest="1" Color="#E0E0E0"/>

                    <CollectionView ItemsSource="{Binding TodaysWorkouts}" 
                                  SelectionMode="None"
                                  Margin="10,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:ExerciseRoutineModel">
                                <Grid Padding="15" 
                                      ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto,Auto">
                                    <Label Text="{Binding ExerciseName}" 
                                           FontSize="16"
                                           FontAttributes="Bold"
                                           Grid.Column="0" Grid.Row="0"/>

                                    <Label Text="{Binding Sets, StringFormat='{0} sets'}"
                                           Grid.Column="0" Grid.Row="1"/>

                                    <Label Text="{Binding Reps, StringFormat='{0} reps'}"
                                           Grid.Column="0" Grid.Row="2"/>

                                    <Label Text="{Binding Difficulty}" 
                                           FontAttributes="Italic"
                                           TextColor="#666666"
                                           Grid.Column="1" Grid.Row="0"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Today's Meals Section -->
            <Frame CornerRadius="15" Padding="0" HasShadow="True">
                <VerticalStackLayout>
                    <Label Text="Today's Meals" 
                           FontSize="18" 
                           FontAttributes="Bold"
                           Margin="15,15,15,10"/>

                    <BoxView HeightRequest="1" Color="#E0E0E0"/>

                    <CollectionView ItemsSource="{Binding TodaysMeals}" 
                                  SelectionMode="None"
                                  Margin="10,0">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="model:DietPlanModel">
                                <Grid Padding="15" 
                                      ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto">
                                    <Label Text="{Binding MealName}" 
                                           FontSize="16"
                                           Grid.Column="0" Grid.Row="0"/>

                                    <Label Text="{Binding MealType}" 
                                           TextColor="#666666"
                                           FontSize="14"
                                           Grid.Column="0" Grid.Row="1"/>

                                    <Label Text="{Binding Protein, StringFormat='{0}g protein'}" 
                                           TextColor="#512BD4"
                                           FontAttributes="Bold"
                                           Grid.Column="1" Grid.Row="0"
                                           VerticalOptions="Center"/>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </Frame>

            <!-- Last Workout Section -->
            <Frame CornerRadius="15" Padding="20" HasShadow="True">
                <VerticalStackLayout Spacing="10">
                    <Label Text="Last Workout" 
                           FontSize="18" 
                           FontAttributes="Bold"/>

                    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
                        <Label Text="{Binding LastWorkout.ExerciseName}" 
                               FontSize="16"
                               FontAttributes="Bold"
                               Grid.Column="0" Grid.Row="0"/>

                        <Label Text="{Binding LastWorkout.Date, StringFormat='Date: {0:MMM dd}'}"
                               Grid.Column="0" Grid.Row="1"/>

                        <Label Text="{Binding LastWorkout.CaloriesBurned, StringFormat='Burned: {0} kcal'}"
                               TextColor="#512BD4"
                               FontAttributes="Bold"
                               Grid.Column="1" Grid.Row="0"
                               HorizontalOptions="End"/>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>